page "Hello CodeGenZ"

style:
  body:
    bg #0f0f17
    color #f5f5f5
    font "Poppins", sans-serif
    pad 0

  .title:
    size 48px
    weight 800
    center

  .btn:
    bg #7c5cff
    color white
    pad 12px 24px
    round 8px
    pointer

var clicks = 0

box .title:
  h1 "Welcome to CodeGenZ"
  p "the easy way to build the web" .subtitle

box .actions:
  button "Click me" .btn click handleClick()
  span "" #counter

script:
  function handleClick() {
    clicks = clicks + 1
    document.getElementById("counter").textContent = "clicks: " + clicks
  }
