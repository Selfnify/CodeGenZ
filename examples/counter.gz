page "Counter"

style:
  body:
    bg #111
    color white
    font system-ui, sans-serif
    center
    pad 60px

  .count:
    size 72px
    weight 800

  .row:
    flex
    gap 12px
    justify center

  .btn:
    bg #222
    color white
    border 1px solid #444
    pad 10px 20px
    round 8px
    pointer

var count = 0

h1 "0" .count #count-display

box .row:
  button "-" .btn #dec
  button "reset" .btn #reset
  button "+" .btn #inc

when click #inc:
  increase count by 1
  set text of #count-display to count

when click #dec:
  decrease count by 1
  set text of #count-display to count

when click #reset:
  set count to 0
  set text of #count-display to count
